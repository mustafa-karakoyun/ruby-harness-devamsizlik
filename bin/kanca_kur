#!/usr/bin/env bash
# bin/kontrol'ü git pre-commit kancası olarak kurar (.git/hooks repoya dahil olmadığı için).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
cat > .git/hooks/pre-commit <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

./bin/kontrol
EOF
chmod +x .git/hooks/pre-commit bin/kontrol
echo "[OK] .git/hooks/pre-commit -> ./bin/kontrol kuruldu."
