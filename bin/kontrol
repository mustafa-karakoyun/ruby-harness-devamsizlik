#!/usr/bin/env bash
set -euo pipefail

echo "=== [1/3] Mimari Dosya Kontrolü ==="
for dosya in "lib/ogrenci.rb" "lib/devamsizlik_kontrol.rb" "test/ogrenci_test.rb"; do
  if [ ! -f "$dosya" ]; then
    echo "[HATA] Zorunlu dosya eksik: $dosya"
    exit 1
  fi
done
echo "[OK] Zorunlu dosyalar mevcut."

echo "=== [2/3] Statik Kod Analizi (Yasaklı Yapılar) ==="
if grep -rnE "def[[:space:]]+method_missing|respond_to_missing\?" lib/; then
  echo "[HATA] lib/ içinde yasaklı 'method_missing' kullanımı tespit edildi!"
  exit 1
fi

if grep -rnE "^[[:space:]]*class[[:space:]]+(Integer|String|Object|Array|Numeric|Symbol|Kernel)\b" lib/; then
  echo "[HATA] lib/ içinde çekirdek sınıflara monkey patch (sınıf açılımı) tespit edildi!"
  exit 1
fi

if ! grep -q "define_method" lib/ogrenci.rb; then
  echo "[HATA] lib/ogrenci.rb içinde durum metotları 'define_method' ile tanımlanmalıdır!"
  exit 1
fi
echo "[OK] Statik analiz temiz (method_missing yok, monkey patch yok, define_method mevcut)."

echo "=== [3/3] Minitest Birim Testleri ==="
ruby -Ilib:test test/ogrenci_test.rb
echo "=== [BAŞARILI] Tüm kontroller 0 hata ile geçti! ==="

